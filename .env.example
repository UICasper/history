# ---- Voice ----
# Default provider is edge-tts (free, no key -- see config/config.json's
# audio.tts_provider). Only needed if you switch tts_provider to "elevenlabs".
ELEVENLABS_API_KEY=

# ---- Free-tier LLM (primary) ----
GEMINI_API_KEY=

# ---- Free-tier LLM (automatic fallback if Gemini is overloaded/unavailable) ----
# Get one free at console.groq.com (sign in with Google/GitHub, no card needed).
GROQ_API_KEY=

# ---- Museum APIs ----
# The Met Collection API: no key required.
# Smithsonian Open Access API: requires a free key from api.data.gov
SMITHSONIAN_API_KEY=
# Rijksmuseum API: requires a free key from data.rijksmuseum.nl
RIJKSMUSEUM_API_KEY=

# ---- Dashboard auth ----
# Any random string; sent as a Bearer token by the frontend to the FastAPI backend.
DASHBOARD_TOKEN=

# ---- Misc ----
# IANA timezone used to resolve the daily schedule time in config/config.json
TIMEZONE=Asia/Ulaanbaatar
